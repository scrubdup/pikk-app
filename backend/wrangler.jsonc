{
  // PIKK API Worker. D1 database provisioned by the owner; Worker itself is not yet deployed.
  "name": "pikk-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  // No "build" block on purpose. A custom build command runs on EVERY Workers Builds run
  // (including PR/preview branches) and on `wrangler dev`/`deploy`. It used to run
  // `wrangler d1 migrations apply DB --remote`, which applied unreviewed branch migrations
  // to production pikk-db. Migrations are applied manually after review, or via
  // `npm run migrate:ci` which refuses unless WORKERS_CI_BRANCH === "main". See README.
  "d1_databases": [
    { "binding": "DB", "database_name": "pikk-db", "database_id": "d545246b-49f7-4a0a-92b4-b18c570baef8", "migrations_dir": "migrations" }
  ],
  // Vault secret (set via `wrangler secret put`, never committed): VAULT_SIGNING_KEY (>=32 chars). Optional var: VAULT_ACCESS_URL_TTL_SEC (default 300).
  // NO top-level "r2_buckets" on purpose: R2 is not provisioned/approved, and Workers Builds
  // (`wrangler versions upload` / `deploy`) fail when a declared bucket doesn't exist. The MEDIA
  // binding is supplied only to tests via vitest.config.js (Miniflare r2Buckets). Without it, Vault
  // and music upload routes return 503 "not configured". Add r2_buckets here only after the owner
  // approves R2 and the bucket exists. (config.test.js enforces this.)
  // PIKK Vault slice 3: Story expiry sweeper + delayed job retries. Cron Triggers are free on the Workers Free plan.
  // Must match PROCESSING.sweeperCron in src/media-config.js. Local test: wrangler dev --test-scheduled, then GET /__scheduled
  // Vault cron work is OFF unless the var VAULT_CRON_ENABLED is "true" (unset by default: the trigger fires, runVaultCron no-ops).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://scrubdup.github.io",
    "COOKIE_SAMESITE": "None",
    "SESSION_TTL_HOURS": "720",
    "EXPOSE_VERIFY_TOKEN": "false",
    "PUBLIC_APP_URL": "https://scrubdup.github.io/pikk-app/"
    // MASTERMIND_JOBS_ENABLED: plain var (not a secret), intentionally UNSET = off pending owner approval.
    // Set to "true" only when the owner approves the Master Mind heartbeat/job runner.
  }
  // Secrets (set via `wrangler secret put`, never committed): RESEND_API_KEY, STRIPE_WEBHOOK_SECRET,
  // OWNER_BOOTSTRAP_TOKEN (optional, >=32 chars, one-time owner bootstrap; delete after use)
  // Master Mind phase 2 heartbeat cron — INTENTIONALLY DISABLED. Owner enables at deploy time by uncommenting:
  // "triggers": { "crons": ["*/5 * * * *"] },
  // Set EMAIL_FROM to a verified sender, e.g. "PIKK <verify@your-domain.example>", before enabling production email.
}
