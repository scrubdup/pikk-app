{
  // PIKK API Worker. LOCAL ONLY: not deployed. database_id is a placeholder until the owner
  // provisions D1 on a permanent Cloudflare account.
  "name": "pikk-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "pikk-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://scrubdup.github.io",
    "COOKIE_SAMESITE": "None",
    "SESSION_TTL_HOURS": "720",
    "EXPOSE_VERIFY_TOKEN": "false"
  }
  // Secrets (set via `wrangler secret put`, never committed): STRIPE_WEBHOOK_SECRET,
  // OWNER_BOOTSTRAP_TOKEN (optional, >=32 chars, one-time owner bootstrap; delete after use)
}
